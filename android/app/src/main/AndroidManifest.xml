<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Needed for WifiManager.getConnectionInfo() in MainActivity.getLocalIpAddress() -
         missing this caused an immediate crash on launch on the first real-device test. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Only needed on API < 29 to write the crash-log export into the public Downloads
         folder (MediaStore handles this without a permission on API 29+). Capped with
         maxSdkVersion so it's a no-op on newer Android and doesn't show as a requested
         permission there. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14 (API 34) requires a specific foreground-service type. "dataSync" is the
         closest fit for "long-running network server" among the predefined types - not
         verified against a real Play/AOSP build, may need to change to another type
         (e.g. "specialUse") if Android rejects "dataSync" for this at runtime. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- For the in-app update flow: main.py downloads a new APK, MainActivity launches the
         system installer for it via an ACTION_VIEW intent - that requires this permission
         from API 26+ (it's what actually gates "install from unknown sources" per-app). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Lets MainActivity prompt the user to exempt this app from Doze/App Standby battery
         optimizations - locking the screen can otherwise get the whole foreground service
         killed on some (especially budget/OEM-skinned) devices regardless of the wake lock. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:label="Phobos Bot"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.PhobosBot">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PhobosService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Exposes the downloaded update APK (which lives in the app's private filesDir,
             same as crash.log etc.) to the system installer via a content:// URI - required
             since API 24, a plain file:// URI is blocked by StrictMode for other apps to read. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.phobosbot.androidhost.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
